{
  "name": "crossport",
  "version": "1.1.1",
  "private": true,
  "description": "Cross-platform file transfer utility",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:versions": "bash scripts/check-versions.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
