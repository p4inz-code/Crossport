{
  "name": "crossport",
  "version": "1.1.2",
  "private": true,
  "description": "Windows file-transfer utility for copying and moving files between mounted volumes",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:versions": "bash scripts/check-versions.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0"
  }
}
